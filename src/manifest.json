{
  "manifest_version": 3,
  "name": "Reader Mode AI",
  "version": "0.1.0",
  "description": "Safari-style reader mode with DeepL AI translation.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Toggle reader mode"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-reader": {
      "suggested_key": { "default": "Alt+R" },
      "description": "Toggle reader mode"
    }
  }
}
